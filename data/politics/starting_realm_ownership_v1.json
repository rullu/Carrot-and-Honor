  "regional_intent": {
    "far_west": "Highly fragmented medieval-European-inspired political landscape; mostly one-province realms with one visibly larger regional kingdom.",
    "south_west": "Calmer and more isolated; comparatively consolidated and suitable for easier starting positions.",
    "north": "Colder region with fewer, more established multi-province kingdoms.",
    "central": "Culturally and politically mixed collision zone with medium-sized established realms.",
    "east": "More consolidated than the west, with generally larger realms, while avoiding oversized monolithic blocs."
  },
